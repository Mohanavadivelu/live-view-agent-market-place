{
  "name": "lv-testbench-system",
  "description": "LV Test Bench pushed into the system image, to prove system push on an emulator with a Google APIs image started with -writable-system",
  "source_roots": ["testbench/app/src/main"],
  "tests": "testbench/app/src/test",
  "app": {
    "package": "dev.liveview.testbench",
    "launch": "dev.liveview.testbench/.HomeActivity"
  },
  "build": {
    "cwd": "testbench",
    "command": "gradlew.bat --offline :app:assembleDebug",
    "test": "gradlew.bat --offline :app:testDebugUnitTest",
    "env": { "JAVA_HOME": "C:/Program Files/Android/Android Studio/jbr" }
  },
  "push": {
    "mode": "system",
    "files": [
      {
        "local": "testbench/app/build/outputs/apk/debug/app-debug.apk",
        "device": "/system/app/LvTestBench/LvTestBench.apk",
        "mode": "644",
        "owner": "root:root"
      }
    ],
    "restart": "stop; start"
  },
  "device": { "serial": "emulator-5556" }
}
